---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => base + '/' + p + '/';
const examples = [
  {name:'Find films', question:'What films are playing at the Rialto?', query:"WHICH Film is showing at (Cinema:'Rialto')", note:'WHICH selects Film. The named cinema constrains the question. No RETURN clause needed.'},
  {name:'Follow relationships', question:'What films did Simon book?', query:"WHICH Film has A Session\nTHAT has A Booking\nTHAT is for (Person:'Simon')", note:'Follow the relationships in the model. A introduces a related object; THAT continues the reading.'},
  {name:'Choose results', question:'Show films, cinemas and times.', query:'WHICH Film is showing at WHICH Cinema at WHICH DateTime', note:'Put WHICH in front of each object type you want returned.'},
];
const showcase = [
  { domain: 'CUSTOMER ORDERS', feature: 'Filter naturally', question: 'Which orders are urgent?', query: "WHICH Order has (Order Priority:'1-URGENT')", explanation: 'Name the object. Add a condition. That is a complete query.' },
  { domain: 'CUSTOMER ORDERS', feature: 'Choose multiple results', question: 'Who bought what?', query: 'WHICH Customer made AN Order\nTHAT is for WHICH Part', explanation: 'Return customers and parts together. WHICH makes the selection explicit.' },
  { domain: 'CINEMA BOOKINGS', feature: 'Follow relationships', question: 'What films did Simon book?', query: "WHICH Film has A Session\nTHAT has A Booking\nTHAT is for (Person:'Simon')", explanation: 'Follow a readable path through the model, from a film to the person who booked.' },
  { domain: 'PIZZA ORDERS', feature: 'Ask about your domain', question: 'What toppings are on a Margherita?', query: "WHICH PizzaTopping is for A PizzaNameHasTopping\nTHAT has (PizzaName:'Margherita')", explanation: 'Use the names and relationship readings in the pizza model to ask a specific question.' },
  { domain: 'CINEMA BOOKINGS', feature: 'Count the matches', question: 'How many seats are in this cinema?', query: "WHICH Seat is in A Row\nin (Cinema:'Great Western Cinema')\nRETURN COUNT(*)", explanation: 'Add RETURN when you want an aggregate instead of the default identifying fields.' },
  { domain: 'SALES ANALYTICS', feature: 'Group and aggregate', question: 'What are total sales by customer city?', query: 'WHICH Sales Order has WHICH Sold To Customer City\nAND WHICH Line Total\nRETURN SalesOrder.SldToCustCity, SalesOrder.SlsLineTotal.SUM\nGROUP BY SalesOrder.SldToCustCity', explanation: 'Keep the domain question readable while expressing exactly how totals should be grouped.' },
];
const highlight = (query: string) => query.split(/('(?:[^']*)'|\b(?:GROUP BY|RETURN|WHICH|THAT|COUNT|SUM|AND|AN|NO|A)\b)/g).map(text => ({text, kind: text.startsWith("'") ? 'value' : /^(GROUP BY|RETURN|WHICH|THAT|COUNT|SUM|AND|AN|NO|A)$/.test(text) ? 'keyword' : 'plain'}));
---
<div class="nexql-home">
  <nav class="home-nav" aria-label="Main navigation"><span class="eyebrow">THE AGENTIC QUERY LANGUAGE / BY FACTENGINE</span><div><a href={link('guides/example')}>Guide</a><a href={link('guides/agents')}>For agents</a><a href={link('reference/examples')}>Examples</a><a href="https://github.com/FactEngineCommunity/NexQL">GitHub ↗</a></div></nav>
  <div class="hero-layout">
  <section class="intro">
    <div class="eyebrow"><span class="status-dot"></span> HUMAN READABLE. AGENT READY.</div>
    <h1 id="_top" data-page-title>The query language<br/>for <span>AI agents.</span></h1>
    <p class="lead">From a question to a query.<br/>With meaning intact.</p>
    <p class="intro-copy">NexQL brings natural-language readability to deterministic database queries. Give your agents the language of your domain. Let FactEngine translate it to SQL or Cypher.</p>
    <div class="actions"><a class="button primary" href={link('guides/example')}>Write your first query <span>↗</span></a><a class="button secondary" href={link('guides/agents')}>Build with NexQL <span>→</span></a></div>
    <div class="proof"><span>Readable intent</span><span>Formal grammar</span><span>SQL + Cypher</span></div>
  </section>
  <section class="query-lab" aria-label="NexQL examples">
    <div class="lab-top"><span><span class="status-dot"></span> QUESTION → NEXQL</span><span class="muted">01 / SEE THE LANGUAGE</span></div>
    <div class="example-buttons" aria-label="Choose an example">{examples.map((e,i)=><button type="button" data-example={i} aria-pressed={i===0}>{e.name}</button>)}</div>
    {examples.map((e,i)=><div class="example-panel" data-panel={i} hidden={i!==0}><div class="question"><span>YOU ASK</span><p>{e.question}</p></div><div class="answer"><div class="code-label"><span>NEXQL</span><button type="button" class="copy" aria-label={'Copy '+e.name+' query'}>Copy query</button></div><pre><code>{highlight(e.query).map(token => <span class={'syntax-' + token.kind}>{token.text}</span>)}</code></pre><p class="query-note">{e.note}</p></div></div>)}
    <div class="lab-bottom"><span>From the NexQL query-by-example collection.</span><span class="copy-status" role="status" aria-live="polite"></span><a href={link('reference/examples')}>Explore the examples →</a></div>
  </section>
  </div>
  <section class="showcase section" aria-labelledby="showcase-title">
    <div class="showcase-heading"><div><span class="eyebrow">REAL QUESTIONS. REAL NEXQL.</span><h2 id="showcase-title">It reads like the question.<br/><span>Because that’s the point.</span></h2></div><p>From a simple lookup to a sales analysis. See how much you can ask with a few words and the relationships in your model.</p></div>
    <div class="showcase-grid">{showcase.map((example, i) => <article class="showcase-card">
      <div class="showcase-meta"><span>{example.domain}</span><span class="showcase-number">0{i + 1}</span></div>
      <h3>{example.question}</h3>
      <div class="answer showcase-answer"><div class="code-label"><span>NEXQL</span><button type="button" class="copy" aria-label={'Copy query: ' + example.question}>Copy query</button></div><pre><code>{highlight(example.query).map(token => <span class={'syntax-' + token.kind}>{token.text}</span>)}</code></pre></div>
      <div class="showcase-caption"><span class="feature-label">{example.feature}</span><p>{example.explanation}</p></div>
    </article>)}</div>
    <div class="showcase-foot"><p>Each example uses its domain’s model vocabulary. <strong>RETURN is optional.</strong></p><a class="text-link" href={link('reference/examples')}>Explore more query examples →</a></div>
  </section>
  <section class="benefits section"><div class="section-heading"><span class="eyebrow">LESS TRANSLATION. MORE INTENT.</span><h2>Close to the question.<br/>Precise at execution.</h2><p>An agent needs a clear way to express what it wants. A database needs a precise query. NexQL connects the two.</p></div><div class="benefit-grid">
    <article><span class="number">01 / GENERATE</span><h3>A shorter step from natural language</h3><p>Object names and relationship readings already sound like the question. Give the AI your model vocabulary and examples to guide query generation.</p></article>
    <article><span class="number">02 / UNDERSTAND</span><h3>Queries you can read and review</h3><p>See which objects an agent selects, which relationships it follows, and which conditions it applies. Keep the question visible in the query.</p></article>
    <article><span class="number">03 / EXECUTE</span><h3>Deterministic translation</h3><p>NexQL has a formal grammar. FactEngine resolves the query against a model and translates it to SQL or Cypher for the target database.</p></article>
  </div></section>
  <section class="pipeline section"><div><span class="eyebrow">A SEMANTIC STEP IN YOUR AGENT STACK</span><h2>Let the agent express intent.<br/>Let the model supply meaning.</h2><p>Keep domain concepts in the agent’s context, and database mappings in FactEngine. The model connects the names and relationships in a query to the data behind them.</p><a class="text-link" href={link('guides/agents')}>Explore the agent workflow →</a></div><ol><li><span>01</span><div><strong>Natural-language question</strong><small>The user’s intent</small></div></li><li class="highlight"><span>02</span><div><strong>NexQL</strong><small>A structured query generated by the agent</small></div></li><li><span>03</span><div><strong>FactEngine + your model</strong><small>Resolve meaning and translate the query</small></div></li><li><span>04</span><div><strong>SQL / Cypher → results</strong><small>Execute against the mapped database</small></div></li></ol></section>
  <section class="which-section section"><div><span class="eyebrow">START WITH ONE WORD</span><h2>WHICH changes<br/>what comes back.</h2><p>Ask for an object. Follow a relationship. Select another object. A query can return useful results without a <code>RETURN</code> clause.</p><a class="text-link" href={link('guides/results')}>Learn how results work →</a></div><div class="which-code"><pre><code><b>WHICH</b> Film</code></pre><p>Return the films.</p><pre><code><b>WHICH</b> Film is showing at <b>WHICH</b> Cinema</code></pre><p>Return the films and the cinemas where they’re showing.</p><div class="detail">For each selected object type, NexQL returns the fields of the first-found uniqueness constraint, falling back to the primary key when no uniqueness constraint is found. Use <code>RETURN</code> for explicit fields and aggregates.</div></div></section>
  <section class="section learn"><span class="eyebrow">FROM CURIOUS TO QUERYING</span><h2>Your next question starts here.</h2><div class="learn-grid"><a href={link('guides/example')}><span>THE GUIDE ↗</span><h3>Learn by asking</h3><p>Build your first query, add conditions, and choose the results.</p></a><a href={link('guides/agents')}><span>FOR BUILDERS ↗</span><h3>Give your agent NexQL</h3><p>Supply model context, guide generation, and validate before execution.</p></a><a href={link('reference/examples')}><span>THE EXAMPLES ↗</span><h3>See it in practice</h3><p>Explore cinema bookings, customer orders, pizza orders, and sales.</p></a></div></section>
  <section class="foundation"><span class="eyebrow">MEANING UNDER THE HOOD</span><p>Built on Object-Role Modeling and Fact-Based Modelling, NexQL asks questions using the concepts and relationships in your domain.</p><a href={link('reference/concepts')}>Meet the foundations →</a></section>
  <section class="closing"><span class="eyebrow">NEXQL / THE AGENTIC QUERY LANGUAGE</span><h2>Give your agents<br/>a language for data.</h2><a class="button primary" href={link('guides/example')}>Start with your first query ↗</a><p>Developed for FactEngine. Explore the language and help shape what comes next.</p></section>
  <footer class="home-footer"><span class="wordmark">Nex<span>QL</span></span><span>A language for questions. A foundation for agents.</span><a href="https://github.com/FactEngineCommunity/NexQL">Contribute on GitHub ↗</a></footer>
</div>
<script>
  function setupExamples() {
    const home = document.querySelector('.nexql-home');
    if (!home || home.hasAttribute('data-ready')) return;
    home.setAttribute('data-ready', 'true');
    const buttons = home.querySelectorAll<HTMLButtonElement>('[data-example]');
    buttons.forEach(button => button.addEventListener('click', () => {
      buttons.forEach(b => b.setAttribute('aria-pressed', String(b === button)));
      home.querySelectorAll<HTMLElement>('[data-panel]').forEach(p => p.hidden = p.dataset.panel !== button.dataset.example);
      home.querySelector('.copy-status')!.textContent = '';
    }));
    home.querySelectorAll<HTMLButtonElement>('.copy').forEach(button => button.addEventListener('click', async () => {
      const query = button.closest('.answer')?.querySelector('code')?.textContent || '';
      const status = home.querySelector('.copy-status')!;
      const original = button.textContent;
      button.textContent = 'Copying…';
      try { await navigator.clipboard.writeText(query); status.textContent = 'Query copied.'; button.textContent = 'Copied ✓'; }
      catch { status.textContent = 'Select the query text to copy it.'; button.textContent = 'Select text to copy'; }
      window.setTimeout(() => { button.textContent = original; }, 2200);
    }));
  }
  setupExamples();
  document.addEventListener('astro:page-load', setupExamples);
</script>
